{
  "name": "@terreno/shared",
  "version": "0.1.0",
  "private": true,
  "description": "Tipos y contratos compartidos entre frontend y backend (ADR-001)",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "require": "./dist/index.js",
      "default": "./src/index.ts"
    },
    "./xlsx": {
      "types": "./src/xlsx/index.ts",
      "import": "./src/xlsx/index.ts",
      "require": "./dist/xlsx/index.js",
      "default": "./src/xlsx/index.ts"
    },
    "./xlsx/serializar": {
      "types": "./src/xlsx/serializar.ts",
      "import": "./src/xlsx/serializar.ts",
      "require": "./dist/xlsx/serializar.js",
      "default": "./src/xlsx/serializar.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "vitest": "^5.0.4"
  }
}
