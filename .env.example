# Copia este archivo a `.env` (no se versiona — Constitución Art. IX) y ajusta
# si hace falta. Estos valores son SOLO para desarrollo local.

# --- PostgreSQL (infra/docker-compose.yml, TSK-WS-002) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=terreno
POSTGRES_PORT=5432
# Password del rol de aplicación `tc_app` (sujeto a RLS). Dev local.
APP_DB_PASSWORD=localdev

# Conexión admin/owner: migraciones y seed (bypassa RLS).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/terreno
# Conexión de la aplicación: rol `tc_app` sujeto a RLS (la usa el backend).
APP_DATABASE_URL=postgres://tc_app:localdev@localhost:5432/terreno

# --- Auth (TSK-WS-003) ---
# Secreto HS256 para firmar el access token (15 min). Generar con
# `openssl rand -base64 48`. Valor SOLO para desarrollo local.
JWT_ACCESS_SECRET=dev-secret-no-utilizar-en-produccion-cambiar
# Origen permitido para CORS en desarrollo (el frontend de Vite).
ALLOWED_ORIGIN=http://localhost:5173

# --- Sync (TSK-WS-007) ---
# Directorio de los bytes de adjuntos que ingresa `POST /api/v1/sync/batch`
# (data-model §2.2, V1 volumen local/Docker). Relativo a cwd si es relativo.
SYNC_VOLUME=.vol/sync

# --- Cuentas demo (TSK-WS-011) ---
# Password compartida de las cuentas de demostración. El backend la lee vía
# DEMO_PASSWORD; el frontend de Vite la recibe como VITE_DEMO_PASSWORD.
# Valor SOLO para desarrollo local / CI de integración.
DEMO_PASSWORD=TcDemo2026!
VITE_DEMO_PASSWORD=TcDemo2026!
