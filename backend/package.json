{
  "name": "@terreno/backend",
  "version": "0.1.0",
  "private": true,
  "description": "API NestJS (monolito modular) — ingesta por lotes idempotente",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "prestart": "npm run build --workspace @terreno/shared",
    "start:dev": "node --watch -r ts-node/register src/main.ts",
    "prestart:dev": "npm run build --workspace @terreno/shared",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "db:migrate": "node-pg-migrate -m db/migrations up",
    "db:rollback": "node-pg-migrate -m db/migrations down",
    "db:seed": "node -r ts-node/register db/seed.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "@node-rs/argon2": "^2.2.2",
    "@terreno/shared": "0.1.0",
    "cookie-parser": "^1.4.7",
    "jose": "^5.10.0",
    "pg": "^8.13.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/testing": "^10.4.22",
    "@swc/core": "^1.16.13",
    "@testcontainers/postgresql": "^10.13.2",
    "@types/cookie-parser": "^1.4.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^7.2.1",
    "node-pg-migrate": "^7.9.1",
    "supertest": "^7.3.1",
    "ts-node": "^10.9.2",
    "unplugin-swc": "^2.0.0",
    "vitest": "^3.0.5"
  }
}
