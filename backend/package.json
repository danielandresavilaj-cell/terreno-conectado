{
  "name": "@terreno/backend",
  "version": "0.1.0",
  "private": true,
  "description": "API NestJS (monolito modular) — ingesta por lotes idempotente",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "prestart": "npm run build --workspace @terreno/shared",
    "start:dev": "node --watch -r ts-node/register src/main.ts",
    "prestart:dev": "npm run build --workspace @terreno/shared",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "db:migrate": "node-pg-migrate -m db/migrations up",
    "db:rollback": "node-pg-migrate -m db/migrations down",
    "db:seed": "node -r ts-node/register db/seed.ts",
    "test": "node scripts/run-vitest.mjs run",
    "test:watch": "node scripts/run-vitest.mjs"
  },
  "dependencies": {
    "@nestjs/common": "^12.1.3",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.1.3",
    "@nestjs/platform-express": "^12.1.3",
    "@node-rs/argon2": "^2.2.2",
    "@terreno/shared": "0.1.0",
    "cookie-parser": "^1.4.7",
    "express": "^5.1.0",
    "jose": "^5.10.0",
    "jszip": "^3.10.1",
    "pg": "^8.13.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/testing": "^12.1.3",
    "@swc/core": "^1.16.13",
    "@testcontainers/postgresql": "^12.2.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^7.2.1",
    "node-pg-migrate": "^9.0.0",
    "supertest": "^7.3.1",
    "ts-node": "^10.9.2",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.0.4"
  }
}
