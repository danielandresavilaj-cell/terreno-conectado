{
  "name": "@terreno/backend",
  "version": "0.1.0",
  "private": true,
  "description": "API NestJS (monolito modular) — ingesta por lotes idempotente",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:dev": "node --watch -r ts-node/register src/main.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "db:migrate": "node-pg-migrate -m db/migrations up",
    "db:rollback": "node-pg-migrate -m db/migrations down",
    "db:seed": "node -r ts-node/register db/seed.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "pg": "^8.13.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^10.13.2",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.10",
    "node-pg-migrate": "^7.9.1",
    "ts-node": "^10.9.2",
    "vitest": "^3.0.5"
  }
}
