# Plantilla de entorno de PRODUCCIÓN (infra/.env en el VPS).
# NO versionar el `.env` real (Constitución Art. IX). Copiar:
#   cp infra/.env.prod.example infra/.env
#
# Las URLs apuntan al servicio `db` de la red interna de Docker Compose.

# --- Borde / dominio -------------------------------------------------------
DOMAIN=demo.terreno.example
ALLOWED_ORIGIN=https://demo.terreno.example

# --- PostgreSQL ------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CAMBIAR-password-owner
POSTGRES_DB=terreno
# Password del rol de aplicación `tc_app` (sujeto a RLS).
APP_DB_PASSWORD=CAMBIAR-password-app
# Conexión owner (migraciones/seed) y de aplicación (backend).
DATABASE_URL=postgres://postgres:CAMBIAR-password-owner@db:5432/terreno
APP_DATABASE_URL=postgres://tc_app:CAMBIAR-password-app@db:5432/terreno

# --- Auth / demo -----------------------------------------------------------
# Generar con: openssl rand -base64 48
JWT_ACCESS_SECRET=CAMBIAR
DEMO_PASSWORD=TcDemo2026!
LOG_LEVEL=info

# --- Imágenes (publicadas por .github/workflows/deploy.yml en GHCR) --------
# El workflow publica `ghcr.io/<GITHUB_REPOSITORY>-<servicio>`, es decir
# `terreno-conectado-backend` / `-frontend` / `-backend-tools`. Deben coincidir
# exactamente o `docker compose pull` fallará con "manifest unknown".
IMAGE_BACKEND=ghcr.io/danielandresavilaj-cell/terreno-conectado-backend:latest
IMAGE_FRONTEND=ghcr.io/danielandresavilaj-cell/terreno-conectado-frontend:latest
IMAGE_BACKEND_TOOLS=ghcr.io/danielandresavilaj-cell/terreno-conectado-backend-tools:latest
