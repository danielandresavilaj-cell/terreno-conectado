# Complementa a .gitattributes: los editores respetan esto al guardar, así el
# fin de línea y la indentación son iguales en cualquier SO (Windows, macOS,
# Linux) y entre editores. Ver CONTRIBUTING.md §9.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Markdown: los dos espacios finales son un salto de línea intencional.
[*.md]
trim_trailing_whitespace = false

# Nunca normalizar binarios.
[*.{png,jpg,jpeg,gif,ico,webp,woff,woff2,xlsx,xls,pdf}]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
